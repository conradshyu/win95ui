/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

IDR_MAINFRAME           ICON    DISCARDABLE     "res\\mfctrack.ico"
IDR_MFCTRATYPE          ICON    DISCARDABLE     "res\\mfctrdoc.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU PRELOAD DISCARDABLE 
BEGIN
    POPUP "&Options"
    BEGIN
        MENUITEM "Set &Range...",               IDM_RANGE
        MENUITEM "Set &Frequency...",           IDM_FREQUENCY
        MENUITEM "Set &Page Size...",           IDM_PAGESIZE
        MENUITEM "Set &Line Size...",           IDM_LINESIZE
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About mfctrack...",          ID_APP_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG DISCARDABLE  34, 22, 217, 55
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About mfctrack"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,18,20
    LTEXT           "mfctrack Version 1.0",IDC_STATIC,39,10,119,8
    LTEXT           "Copyright \251 1995",IDC_STATIC,39,39,119,8
    DEFPUSHBUTTON   "OK",IDOK,176,6,32,14,WS_GROUP
    LTEXT           "Nancy Winnick Cluts",IDC_STATIC,39,22,87,13
END

IDD_Range DIALOG DISCARDABLE  0, 0, 189, 97
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Set Trackbar Range"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,15,71,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,83,71,50,14
    LTEXT           "Which trackbar?",IDC_STATIC,12,12,61,7
    LTEXT           "Minimum:",IDC_STATIC,12,33,29,7
    LTEXT           "Maximum:",IDC_STATIC,12,49,37,7
    EDITTEXT        IDE_MIN,65,31,40,12,ES_AUTOHSCROLL
    EDITTEXT        IDE_MAX,65,50,40,12,ES_AUTOHSCROLL
    EDITTEXT        IDE_SLIDER,76,9,26,12,ES_AUTOHSCROLL
END

IDD_FREQUENCY DIALOG DISCARDABLE  0, 0, 189, 97
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Set Tic Frequency"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,15,71,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,83,71,50,14
    LTEXT           "Which trackbar?",IDC_STATIC,11,11,63,7
    LTEXT           "Frequency:",IDC_STATIC,15,41,37,11
    EDITTEXT        IDE_FREQUENCY,85,40,40,12,ES_AUTOHSCROLL
    EDITTEXT        IDE_SLIDER,87,11,40,12,ES_AUTOHSCROLL
END

IDD_PAGESIZE DIALOG DISCARDABLE  0, 0, 189, 97
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Set Page Size"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,15,71,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,83,71,50,14
    LTEXT           "Which trackbar?",IDC_STATIC,12,12,56,7
    LTEXT           "Page size:",IDC_STATIC,13,39,37,11
    EDITTEXT        IDE_PAGESIZE,67,37,40,12,ES_AUTOHSCROLL
    EDITTEXT        IDE_SLIDER,68,11,40,12,ES_AUTOHSCROLL
END

IDD_LINESIZE DIALOG DISCARDABLE  0, 0, 189, 97
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Set Line Size"
