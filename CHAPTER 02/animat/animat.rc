//
// Icon
//

EXE_ICON                ICON    DISCARDABLE     "animat.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

OPTIONSMENU MENU DISCARDABLE 
BEGIN
    POPUP "&Options"
    BEGIN
        MENUITEM "&Run Demo",                   IDM_ANIMATE
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       IDM_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About...",                   IDM_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

ABOUTBOX DIALOG DISCARDABLE  160, 78, 144, 77
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "About the Animate Control Sample"
FONT 8, "MS Sans Serif"
BEGIN
    PUSHBUTTON      "OK",IDOK,54,51,40,14
    LTEXT           "Animate Demo version 1.0",-1,28,17,92,8
    LTEXT           "written by Nancy Cluts",-1,36,27,76,8,NOT WS_GROUP
    LTEXT           "Microsoft Developer Network",-1,25,37,99,8,NOT WS_GROUP
END

IDD_ANIMATE DIALOG DISCARDABLE  0, 0, 304, 146
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Animation Demo"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "Quit",IDOK,223,122,50,14
    CONTROL         "Generic1",IDC_ANIMATE,"SysAnimate32",WS_BORDER | 
                    WS_TABSTOP | 0x3,22,17,251,88
    PUSHBUTTON      "Play",IDC_PLAY,22,122,49,14
    PUSHBUTTON      "Stop",IDC_STOP,89,122,49,14
    PUSHBUTTON      "Seek",IDC_SEEK,156,122,49,14
END


