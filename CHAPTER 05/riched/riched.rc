/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

RICHED_ICON             ICON    DISCARDABLE     "riched.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Bitmap
//

IDB_TOOLBAR             BITMAP  DISCARDABLE     "toolbar.bmp"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

RICHEDMENU MENU DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open TXT file",              IDM_OPENTXT
        MENUITEM "Open &RTF File",              IDM_OPENRTF
        MENUITEM SEPARATOR
        MENUITEM "&Save as TXT file",           IDM_SAVETXT
        MENUITEM "S&ave as RTF file",           IDM_SAVERTF
        MENUITEM SEPARATOR
        MENUITEM "&Print",                      IDM_PRINT
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       IDM_EXIT
    END
    POPUP "&Options"
    BEGIN
        MENUITEM "&Bold",                       IDM_BOLD
        MENUITEM "&Italic",                     IDM_ITALIC
        MENUITEM "&Underline",                  IDM_UNDERLINE
        MENUITEM SEPARATOR
        MENUITEM "Align &Left",                 IDM_ALIGNLEFT
        MENUITEM "Align &Center",               IDM_ALIGNCENTER
        MENUITEM "Align &Right",                IDM_ALIGNRIGHT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About...",                   IDM_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

ABOUTBOX DIALOG DISCARDABLE  160, 78, 144, 77
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "About the Rich Edit Sample"
FONT 8, "MS Sans Serif"
BEGIN
    PUSHBUTTON      "OK",IDOK,54,51,40,14
    LTEXT           "Rich Edit Sample version 1.0",-1,28,17,92,8
    LTEXT           "written by Nancy Cluts",-1,36,27,76,8,NOT WS_GROUP
    LTEXT           "Microsoft Developer Network",-1,25,37,99,8,NOT WS_GROUP
END


