#include <windows.h>        // standard windows include
#include "treeview.h"        

APP_ICON ICON treeview.ico

FORSALE  BITMAP forsale.bmp
REDMOND  BITMAP red.bmp
BELLEVUE BITMAP bel.bmp
SEATTLE  BITMAP sea.bmp

STRINGTABLE
BEGIN
    IDS_FORSALE    "For Sale"
    IDS_REDMOND    "Redmond"
    IDS_BELLEVUE   "Bellevue"
    IDS_SEATTLE    "Seattle"
END

TreeViewMenu MENU
BEGIN
    POPUP        "&Options"
    BEGIN
        MENUITEM "E&xit", IDM_EXIT
    END
    POPUP        "&Help"
    BEGIN
        MENUITEM "&About...", IDM_ABOUT
    END
END

// About box
AboutBox DIALOG 160, 78, 144, 77
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "About Tree View Sample"
FONT 8, "MS Sans Serif"
BEGIN
    PUSHBUTTON      "OK", IDOK, 54, 51, 40, 14
    LTEXT           "Tree View Sample version 1.0", -1, 28, 17, 92, 8
    LTEXT           "written by Nancy Cluts", -1, 36, 27, 76, 8, NOT 
                    WS_GROUP
    LTEXT           "Microsoft Developer Network", -1, 25, 37, 99, 8, NOT 
                    WS_GROUP
END


