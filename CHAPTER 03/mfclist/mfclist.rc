BEGIN
    POPUP "&Options"
    BEGIN
        MENUITEM "Large &Icon View",            IDM_LARGEICON
        MENUITEM "&Small Icon View",            IDM_SMALLICON
        MENUITEM "&List View",                  IDM_LISTVIEW
        MENUITEM "&Details View",               IDM_DETAILS
        MENUITEM "E&xit",                       IDM_EXIT
        MENUITEM SEPARATOR
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About mfclist...",           ID_APP_ABOUT
    END
END


