// Dialog
//

IDD_ABOUTBOX DIALOG DISCARDABLE  34, 22, 217, 55
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About mfcexp"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,18,20
    LTEXT           "mfcexp Version 1.0",IDC_STATIC,40,10,119,8
    LTEXT           "Copyright \251 1995",IDC_STATIC,40,37,119,8
    DEFPUSHBUTTON   "OK",IDOK,176,6,32,14,WS_GROUP
    LTEXT           "by Nancy Winnick Cluts",IDC_STATIC,40,21,117,13
END

IDD_ADDHOUSE DIALOG DISCARDABLE  0, 0, 222, 127
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Add a House to the Listings"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Address:",IDC_STATIC,9,14,31,7
    LTEXT           "City:",IDC_STATIC,9,30,29,10
    LTEXT           "Price:",IDC_STATIC,9,46,29,10
    LTEXT           "Bedrooms:",IDC_STATIC,9,65,38,11
    LTEXT           "Bathrooms:",IDC_STATIC,119,65,45,7
    EDITTEXT        IDE_ADDRESS,69,12,142,12,ES_AUTOHSCROLL
    COMBOBOX        IDC_CITY,69,30,119,30,CBS_DROPDOWN | CBS_SORT | 
                    WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDE_PRICE,69,47,120,12,ES_AUTOHSCROLL
    EDITTEXT        IDE_BEDROOMS,69,62,40,12,ES_AUTOHSCROLL
    EDITTEXT        IDE_BATHROOMS,167,63,39,12,ES_AUTOHSCROLL
    PUSHBUTTON      "OK",IDOK,27,99,49,14
    PUSHBUTTON      "Cancel",IDCANCEL,104,99,49,14
END

IDD_ADDCITY DIALOG DISCARDABLE  0, 0, 186, 69
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Add a New City to the Listing"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "City:",IDC_STATIC,7,14,29,9
    EDITTEXT        IDE_CITY,37,13,124,12,ES_AUTOHSCROLL
    PUSHBUTTON      "OK",IDOK,23,38,49,14
    PUSHBUTTON      "Cancel",IDCANCEL,92,39,51,14
END

IDD_REMHOUSE DIALOG DISCARDABLE  0, 0, 186, 130
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Remove a house from the Listing"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Remove this house from the listing:",IDC_STATIC,13,12,
                    143,10
    LISTBOX         ID_LISTBOX,10,34,164,71,LBS_SORT | LBS_NOINTEGRALHEIGHT | 
                    WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "OK",IDOK,27,110,49,14
    PUSHBUTTON      "Cancel",IDCANCEL,98,110,49,14
END

IDD_HOUSEPROP DIALOG DISCARDABLE  0, 0, 186, 82
STYLE WS_CHILD | WS_VISIBLE | WS_DISABLED | WS_CAPTION | WS_SYSMENU
CAPTION "House Listing"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Address:",IDC_STATIC,14,12,35,7
    LTEXT           "City:",IDC_STATIC,14,25,31,10
    LTEXT           "Price:",IDC_STATIC,14,41,29,7
    LTEXT           "Bedrooms:",IDC_STATIC,14,54,35,7
    LTEXT           "Bathrooms:",IDC_STATIC,14,67,36,9
    EDITTEXT        IDE_ADDRESS,52,10,123,12,ES_AUTOHSCROLL
    EDITTEXT        IDE_PRICE,52,39,94,12,ES_AUTOHSCROLL
    EDITTEXT        IDE_BEDROOMS,52,52,29,12,ES_AUTOHSCROLL
    EDITTEXT        IDE_BATHROOMS,52,65,30,12,ES_AUTOHSCROLL
    COMBOBOX        IDE_CITY,52,25,124,30,CBS_DROPDOWN | CBS_SORT | 
                    WS_VSCROLL | WS_TABSTOP
END

IDD_AGENT DIALOG DISCARDABLE  0, 0, 186, 95
STYLE WS_CHILD | WS_VISIBLE | WS_DISABLED | WS_CLIPSIBLINGS | WS_CAPTION
CAPTION "Listing Agent"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Agent Name:",IDC_STATIC,11,19,52,11
    LTEXT           "Phone Number:",IDC_STATIC,11,36,53,7
    EDITTEXT        IDE_AGENTNAME,65,19,109,12,ES_AUTOHSCROLL
    EDITTEXT        IDE_PHONE,65,33,109,12,ES_AUTOHSCROLL
END


